{
  "config": {
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_device%]"
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "home_ip_and_entity": "Enter either a home IP address or a home IP address entity, not both.",
      "invalid_auth": "[%key:common::config_flow::error::invalid_auth%]",
      "invalid_ip": "Invalid IP address."
    },
    "step": {
      "user": {
        "data": {
          "home_ip": "Home IP address",
          "home_ip_entity": "Home IP address entity",
          "password": "[%key:common::config_flow::data::password%]",
          "url": "[%key:common::config_flow::data::url%]",
          "username": "[%key:common::config_flow::data::username%]",
          "verify_ssl": "[%key:common::config_flow::data::verify_ssl%]"
        },
        "data_description": {
          "home_ip": "Your public IP address when not using the VPN. Leave empty to use an entity instead, or to skip the VPN connected sensor.",
          "home_ip_entity": "An entity whose state is your public IP address when not using the VPN, for example a router's external IP sensor."
        }
      }
    }
  },
  "entity": {
    "binary_sensor": {
      "vpn_connected": {
        "name": "VPN connected"
      }
    },
    "button": {
      "start_all_torrents": {
        "name": "Start all torrents"
      },
      "stop_all_torrents": {
        "name": "Stop all torrents"
      }
    },
    "sensor": {
      "active_torrents": {
        "name": "Active torrents",
        "unit_of_measurement": "torrents"
      },
      "all_torrents": {
        "name": "All torrents",
        "unit_of_measurement": "[%key:component::qbittorrent::entity::sensor::active_torrents::unit_of_measurement%]"
      },
      "alltime_download": {
        "name": "All-time download"
      },
      "alltime_upload": {
        "name": "All-time upload"
      },
      "connection_status": {
        "name": "Connection status",
        "state": {
          "connected": "[%key:common::state::connected%]",
          "disconnected": "[%key:common::state::disconnected%]",
          "firewalled": "Firewalled"
        }
      },
      "current_status": {
        "name": "Status",
        "state": {
          "downloading": "Downloading",
          "idle": "[%key:common::state::idle%]",
          "seeding": "Seeding",
          "up_down": "Up/Down"
        }
      },
      "download_speed": {
        "name": "Download speed"
      },
      "download_speed_limit": {
        "name": "Download speed limit"
      },
      "errored_torrents": {
        "name": "Errored torrents",
        "unit_of_measurement": "[%key:component::qbittorrent::entity::sensor::active_torrents::unit_of_measurement%]"
      },
      "external_ip_v4": {
        "name": "External IPv4 address"
      },
      "external_ip_v6": {
        "name": "External IPv6 address"
      },
      "global_ratio": {
        "name": "Global ratio"
      },
      "inactive_torrents": {
        "name": "Inactive torrents",
        "unit_of_measurement": "[%key:component::qbittorrent::entity::sensor::active_torrents::unit_of_measurement%]"
      },
      "paused_torrents": {
        "name": "Paused torrents",
        "unit_of_measurement": "[%key:component::qbittorrent::entity::sensor::active_torrents::unit_of_measurement%]"
      },
      "upload_speed": {
        "name": "Upload speed"
      },
      "upload_speed_limit": {
        "name": "Upload speed limit"
      }
    },
    "switch": {
      "alternative_speed": {
        "name": "Alternative speed"
      }
    }
  },
  "exceptions": {
    "cannot_connect": {
      "message": "Can't connect to qBittorrent, please check your configuration."
    },
    "invalid_device": {
      "message": "No device with ID {device_id} was found"
    },
    "invalid_entry_id": {
      "message": "No entry with ID {device_id} was found"
    },
    "login_error": {
      "message": "A login error occurred. Please check your username and password."
    },
    "unknown_torrents": {
      "message": "No torrent found matching: {torrents}"
    }
  },
  "options": {
    "error": {
      "home_ip_and_entity": "[%key:component::qbittorrent::config::error::home_ip_and_entity%]",
      "invalid_ip": "[%key:component::qbittorrent::config::error::invalid_ip%]"
    },
    "step": {
      "init": {
        "data": {
          "home_ip": "[%key:component::qbittorrent::config::step::user::data::home_ip%]",
          "home_ip_entity": "[%key:component::qbittorrent::config::step::user::data::home_ip_entity%]"
        },
        "data_description": {
          "home_ip": "[%key:component::qbittorrent::config::step::user::data_description::home_ip%]",
          "home_ip_entity": "[%key:component::qbittorrent::config::step::user::data_description::home_ip_entity%]"
        },
        "description": "Configure your home (non-VPN) IP address for the VPN connected sensor. The VPN is reported as disconnected when qBittorrent's external IP matches it."
      }
    }
  },
  "services": {
    "delete_torrents": {
      "description": "Removes one or more torrents.",
      "fields": {
        "device_id": {
          "description": "[%key:component::qbittorrent::services::get_torrents::fields::device_id::description%]",
          "name": "[%key:common::config_flow::data::device%]"
        },
        "torrents": {
          "description": "[%key:component::qbittorrent::services::start_torrents::fields::torrents::description%]",
          "name": "[%key:component::qbittorrent::services::start_torrents::fields::torrents::name%]"
        },
        "delete_files": {
          "description": "Also delete the downloaded files from disk.",
          "name": "Delete files"
        }
      },
      "name": "Delete torrents"
    },
    "get_all_torrents": {
      "description": "Gets a list of current torrents from all instances of qBittorrent",
      "fields": {
        "torrent_filter": {
          "description": "What kind of torrents you want to return, such as All or Active.",
          "name": "Torrent filter"
        }
      },
      "name": "Get all torrents"
    },
    "get_torrents": {
      "description": "Gets a list of current torrents",
      "fields": {
        "device_id": {
          "description": "Which service to grab the list from",
          "name": "[%key:common::config_flow::data::device%]"
        },
        "torrent_filter": {
          "description": "What kind of torrents you want to return, such as All or Active.",
          "name": "Torrent filter"
        }
      },
      "name": "Get torrents"
    },
    "start_torrents": {
      "description": "Starts one or more torrents.",
      "fields": {
        "device_id": {
          "description": "[%key:component::qbittorrent::services::get_torrents::fields::device_id::description%]",
          "name": "[%key:common::config_flow::data::device%]"
        },
        "torrents": {
          "description": "Names or hashes of the torrents.",
          "name": "Torrents"
        }
      },
      "name": "Start torrents"
    },
    "stop_torrents": {
      "description": "Stops one or more torrents.",
      "fields": {
        "device_id": {
          "description": "[%key:component::qbittorrent::services::get_torrents::fields::device_id::description%]",
          "name": "[%key:common::config_flow::data::device%]"
        },
        "torrents": {
          "description": "[%key:component::qbittorrent::services::start_torrents::fields::torrents::description%]",
          "name": "[%key:component::qbittorrent::services::start_torrents::fields::torrents::name%]"
        }
      },
      "name": "Stop torrents"
    }
  }
}
